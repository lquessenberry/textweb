{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lquessenberry/textweb/blob/main/data/schema/status.schema.json",
  "title": "textweb API status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "license",
    "last_run",
    "counts",
    "checksums"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {"const": "https://github.com/lquessenberry/textweb"},
    "license": {"const": "MIT"},
    "last_run": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sites", "catalog"],
      "properties": {
        "sites": {"$ref": "#/$defs/counts"},
        "catalog": {"$ref": "#/$defs/counts"}
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sites", "catalog"],
      "properties": {
        "sites": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "catalog": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "up", "down", "unchecked", "skipped"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "up": {"type": "integer", "minimum": 0},
        "down": {"type": "integer", "minimum": 0},
        "unchecked": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    }
  }
}
