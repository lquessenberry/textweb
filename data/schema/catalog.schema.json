{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lquessenberry/textweb/blob/main/data/schema/catalog.schema.json",
  "title": "textweb starter catalog",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "schema_version",
    "updated",
    "generated_at",
    "description",
    "source",
    "license",
    "counts",
    "checksum",
    "tiers",
    "sections",
    "notes"
  ],
  "properties": {
    "version": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "description": {"type": "string"},
    "source": {"const": "https://github.com/lquessenberry/textweb"},
    "license": {"const": "MIT"},
    "counts": {"$ref": "#/$defs/counts"},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tiers": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "up", "down", "unchecked", "skipped"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "up": {"type": "integer", "minimum": 0},
        "down": {"type": "integer", "minimum": 0},
        "unchecked": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "range", "resources"],
      "properties": {
        "name": {"type": "string"},
        "range": {"type": "string"},
        "resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/resource"}
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "url",
        "tier",
        "status",
        "last_checked",
        "http_status",
        "health",
        "fetched_at",
        "media_type",
        "mime_type",
        "size_bytes",
        "license",
        "source",
        "content_hash",
        "snapshot",
        "peer_votes"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "tier": {"type": "integer", "minimum": 1, "maximum": 4},
        "tags": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["ok", "down", "unchecked", "skipped"]},
        "last_checked": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          ]
        },
        "http_status": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 100, "maximum": 599}
          ]
        },
        "health": {"enum": ["verified", "stale", "broken", "unchecked"]},
        "fetched_at": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
          ]
        },
        "media_type": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "mime_type": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "size_bytes": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "license": {"type": "string", "minLength": 1},
        "source": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "content_hash": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "snapshot": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "peer_votes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
